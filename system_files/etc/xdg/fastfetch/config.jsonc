// SuperAwesomeMagicalLinux's fastfetch: our mark instead of Fedora's, in the scheme's purple and
// green. A ~/.config/fastfetch/config.jsonc of your own replaces this file.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/superawesomemagical/fastfetch-logo.txt",
        "color": { "1": "magenta", "2": "green" },
        "padding": { "top": 1, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "magenta", "title": "green" }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "packages",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "battery",
        "break",
        "colors"
    ]
}
