# SuperAwesomeMagicalLinux's defaults for GTK apps: Lexend, dark, Papirus icons. A person's own
# settings (including the ones the shell writes when the colour scheme changes) win over these.

[org/gnome/desktop/interface]
font-name='Lexend Medium 11'
document-font-name='Lexend 11'
monospace-font-name='Cascadia Code NF 11'
gtk-theme='adw-gtk3-dark'
icon-theme='Papirus-Dark'
color-scheme='prefer-dark'
cursor-theme='Adwaita'
cursor-size=24
font-hinting='slight'
font-antialiasing='grayscale'

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:close'

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/superawesomemagical/aurora.jpg'
picture-uri-dark='file:///usr/share/backgrounds/superawesomemagical/aurora.jpg'

# Text Editor writes in Lexend too (code still gets the monospace font in the terminal).
[org/gnome/TextEditor]
use-system-font=false
custom-font='Lexend 12'
