#!/usr/bin/bash
# Gives an account SuperAwesomeMagicalLinux's starting files the first time it signs in. Runs at
# every sign-in, but only ever adds what's missing: nothing a person has changed is overwritten.
set -u

config=${XDG_CONFIG_HOME:-$HOME/.config}
share=/usr/share/superawesomemagical

mkdir -p "$config/caelestia" "$config/hypr/scheme"

# The shell's settings (its own settings screen edits this file), and the CLI's, which leave out
# theming for apps the image doesn't have.
[ -e "$config/caelestia/shell.json" ] || cp "$share/caelestia/shell.json" "$config/caelestia/shell.json"
[ -e "$config/caelestia/cli.json" ] || cp "$share/caelestia/cli.json" "$config/caelestia/cli.json"

# Places for the person's own Hyprland changes, with a note on how to use them.
[ -e "$config/caelestia/hypr-vars.lua" ] || cat > "$config/caelestia/hypr-vars.lua" <<'EOF'
-- Change any of the desktop's settings here. The full list is Caelestia's, in
-- /usr/share/superawesomemagical/hypr/caelestia/variables.lua; SuperAwesomeMagicalLinux's own
-- changes to it are in /usr/share/superawesomemagical/hypr/hyprland.lua. Changes apply right away.
return {
    -- windowRounding = 10,
    -- kbTerminal = "SUPER + Return",
}
EOF
[ -e "$config/caelestia/hypr-user.lua" ] || cat > "$config/caelestia/hypr-user.lua" <<'EOF'
-- Your own Hyprland config, loaded after everything else, e.g.
--   hl.monitor({ output = "DP-1", mode = "2560x1440@144", position = "0x0", scale = 1 })
-- Hyprland's Lua config is documented at https://wiki.hypr.land
EOF

# Usual folders (Pictures, Downloads, ...), and the wallpapers in the shell's wallpaper picker.
xdg-user-dirs-update 2>/dev/null || true
pictures=$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")
mkdir -p "$pictures/Wallpapers"
[ -e "$pictures/Wallpapers/SuperAwesomeMagical" ] ||
    ln -s /usr/share/backgrounds/superawesomemagical "$pictures/Wallpapers/SuperAwesomeMagical"

exit 0
